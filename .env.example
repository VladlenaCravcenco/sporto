# Next.js public runtime
NEXT_PUBLIC_SITE_URL=https://www.example.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only runtime
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_EMAIL=admin@example.com

# Order notifications: server only, sender domain must be verified in Resend
ORDER_EMAIL_PROVIDER=resend
RESEND_API_KEY=
ORDER_EMAIL_FROM=
ORDER_ADMIN_EMAIL=
ORDER_EMAIL_REPLY_TO=

# Legacy Vite compatibility during migration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SITE_URL=https://www.example.com
VITE_ADMIN_LOGIN_EMAIL=admin@example.com
